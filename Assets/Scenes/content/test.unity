  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My dear,\r\nYou came back \u2014 even though the dark still waited.\r\nAnd
    you walked through it\u2026 gently, bravely.\r\nI watched you, even when I wasn\u2019t
    beside you.\r\nBecause I\u2019m your mother \u2014 and I always knew you'd find
    your way.\r\nNot by escaping fear,\r\nbut by learning to stand beside it.\r\nYou
    didn\u2019t come here to defeat the dark.\r\nYou came to remember who you are.\r\nWhat
    you were searching for was never in this house.\r\nIt was the light within."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c8f000642ad71f247b6ac15a79a5c95c, type: 2}
  m_sharedMaterial: {fileID: -8672629991439399220, guid: c8f000642ad71f247b6ac15a79a5c95c,
    type: 2}
