  - {fileID: 2800000, guid: b8247c76b2760034197ffa141a116fb6, type: 3}
  flashlight: {fileID: 1075925996}
  flashlightBody: {fileID: 281775511}
  blackBackground: {fileID: 1273648493}
  fadeDuration: 5
  letter: {fileID: 644647726}
  letterBack: {fileID: 1192830792}
  letterFade: 2
  skipIntro: 0
  IntroTexts:
  - "You\u2019ve come back... The house stands quiet, untouched by time \u2014 yet
    everything speaks. Dust in the light. Silence in the walls."
  - "It\u2019s been years since you walked these rooms. Maybe you didn\u2019t expect
    to return. Maybe not like this. But something calls you forward."
  - "Step by step, through the glow and the growing dark, you search \u2014 not just
    for what was left behind,"
  - but for what might still live inside you. The warmth, the fear, the memory...
    and perhaps, the light within.
  - Let the quiet guide you. Let the shadows speak. Begin.
  introText: {fileID: 921110258}
  introFadeIn: 1
  introHold: 1.8
  introFadeOut: 0.8
  introGap: 0.2
  bgFadeOutAtEnd: 1
  VrIntroAction: {fileID: 9157691874595050682, guid: c348712bda248c246b8c49b3db54643f,
    type: 3}
  VrFlashlightAction: {fileID: -565470871031886239, guid: c348712bda248c246b8c49b3db54643f,
    type: 3}
  hintBack: {fileID: 1199132040}
  hint: {fileID: 152411127}
  hintDisplacement: 700
  hintTimeout: 5
  room1Hints:
  - "You left yourself a way through. You always did. It\u2019s still here \u2014
    somewhere close."
  - "You didn\u2019t trust the dark back then, so you kept a little light nearby.
    Reach for it \u2014 like you used to."
  room1HintDelays:
  - 3
  - 3
  room2Hints:
  - "Your room was always kept closed. Not locked out of fear \u2014 just memory.
    The key is near. You\u2019ll know it when you touch it."
  - "It didn\u2019t seem important back then. A small thing, forgotten in a drawer.
    But now, it\u2019s the only thing that fits what was left behind."
  room2HintDelays:
  - 3
  - 3
  room3Hints:
  - "You left before you were ready to read it. Now, maybe you are. It\u2019s here
    \u2014 and it\u2019s been waiting just for you."
  room3HintDelays:
  - 3
  - 3
  player: {fileID: 2016547237}
  MotionSicknessFilter: {fileID: 1409133785}
